# Models and effort used by delegate-tasks. Model format: provider/model (list them with `opencode models`).
# Copy this file to models.env and edit it: models.env is yours (it is not tracked by git). Without it the scripts use this file.
# Edit here to change the default, or override for one run: IMPL_MODEL=... bash delegate.sh ...
# Phases 1 and 5 (plan, integration) use the orchestrator: the model that invoked the skill. Set it in your harness.

# Phase 2, implementation. Empty = OpenCode's own default model.
IMPL_MODEL=opencode-go/deepseek-v4.1-flash
# Phase 4 and the implement loop retries. Empty = same as IMPL_MODEL.
FIX_MODEL=opencode-go/deepseek-v4.1-flash
# Phase 3, the two blind judges. Use two different models.
JUDGE1_MODEL=opencode-go/minimax-m3
JUDGE2_MODEL=opencode-go/qwen3.8-flash

# Max implement passes per task: after each pass the done command runs; while it fails the agent is sent back.
MAX_LOOPS=5

# Reasoning effort per actor (OpenCode --variant). "max" means the highest variant that model offers: the names differ
# per model (low/high/max, low/medium/xhigh, none/thinking...), so the scripts translate it. Empty = the model's default.
IMPL_EFFORT=max
FIX_EFFORT=max
JUDGE1_EFFORT=max
JUDGE2_EFFORT=max

# Phase 6, the final report: one headless call with a tiny fresh context, see report.sh. A Claude model id goes through the claude CLI
# (Anthropic subscription); a provider/model id (for example opencode-go/qwen3.8-flash) goes through opencode, so any provider works.
REPORT_MODEL=claude-sonnet-5-5
REPORT_EFFORT=medium

# Time limits in seconds. A worker or fix actor over IMPL_TIMEOUT is killed and that pass counts as failed; a judge over
# JUDGE_TIMEOUT is retried once, then reported with no result; REPORT_TIMEOUT only applies to a report run through opencode.
IMPL_TIMEOUT=1800
JUDGE_TIMEOUT=900
REPORT_TIMEOUT=600
